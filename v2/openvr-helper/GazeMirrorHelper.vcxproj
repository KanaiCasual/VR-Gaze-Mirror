<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- VR Gaze Mirror 2.0 - the OpenVR helper: the producer for SteamVR (OpenVR) games. Built against Valve's
       official OpenVR SDK (external\openvr, fetched by Get-External.ps1) and the shared core. Release x64 only. -->
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{C9E4B2A7-1D3F-4A8C-B5E6-7F0A1B2C3D4E}</ProjectGuid>
    <RootNamespace>GazeMirrorHelper</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>v143</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <WholeProgramOptimization>true</WholeProgramOptimization>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <OutDir>$(ProjectDir)..\bin\helper\</OutDir>
    <IntDir>$(ProjectDir)..\obj\helper\</IntDir>
    <TargetName>GazeMirrorHelper</TargetName>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <Optimization>MaxSpeed</Optimization>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <PreprocessorDefinitions>NDEBUG;_WINDOWS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(ProjectDir)..\external\openvr;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <DisableSpecificWarnings>4201;%(DisableSpecificWarnings)</DisableSpecificWarnings>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <AdditionalDependencies>$(ProjectDir)..\bin\core\GazeMirrorCore.lib;$(ProjectDir)..\external\openvr\openvr_api.lib;d3d11.lib;dxgi.lib;d3dcompiler.lib;user32.lib;ws2_32.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <GenerateDebugInformation>false</GenerateDebugInformation>
    </Link>
    <PostBuildEvent>
      <Command>copy /y "$(ProjectDir)..\external\openvr\openvr_api.dll" "$(OutDir)" &gt; nul</Command>
    </PostBuildEvent>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="main.cpp" />
    <ClCompile Include="vrchat_osc.cpp" />
    <ClCompile Include="calibration.cpp" />
    <ClCompile Include="headset_marker.cpp" />
    <ClCompile Include="raw_gaze.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\core\GazeMirrorCore.vcxproj">
      <Project>{5D0A7F21-6B3C-4E8D-9A45-1C2B3D4E5F60}</Project>
      <LinkLibraryDependencies>false</LinkLibraryDependencies>
    </ProjectReference>
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
