<Application x:Class="GazeOverlay.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GazeOverlay"
             ThemeMode="Dark">
    <Application.Resources>
        <!-- The palette: a near-black rail, a dark ground, slightly lighter cards, one blue accent for the app's own marks.
             The theme's controls (check boxes, sliders, the accent button) keep the Windows accent colour, as every Fluent app does. -->
        <SolidColorBrush x:Key="Accent" Color="#28AAF5" />
        <SolidColorBrush x:Key="Muted" Color="#8B93A1" />
        <SolidColorBrush x:Key="Text" Color="#E8EAEE" />
        <SolidColorBrush x:Key="Line" Color="#262B33" />
        <SolidColorBrush x:Key="Panel" Color="#171A20" />
        <SolidColorBrush x:Key="Rail" Color="#0D0F13" />
        <SolidColorBrush x:Key="RailSelected" Color="#1A1F28" />
        <SolidColorBrush x:Key="RailHover" Color="#14181F" />
        <SolidColorBrush x:Key="WindowBack" Color="#111318" />
        <SolidColorBrush x:Key="Picture" Color="#0B0C0E" />
        <SolidColorBrush x:Key="Good" Color="#3CB371" />
        <!-- The icon font of Windows 11, and of Windows 10 where the first is missing. -->
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- No implicit Button style here: it would replace the theme's dark button template with the classic light one. -->
        <!-- A scroll viewer's viewport height minus the margins of the panel inside it (see the Mirror tab). -->
        <local:LessMarginConverter x:Key="LessMargin" />

        <!-- One spacing for every page: 20 px to the sides, 16 above, 14 below; 10 px between cards. -->
        <Thickness x:Key="PageMargin">20,16,20,14</Thickness>

        <!-- A card: one topic's settings, on a slightly lighter ground with a thin line around it. -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,11,14,13" />
        </Style>
        <!-- The small capitals over a card's contents. -->
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <!-- The name of a page, top left. -->
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,14,0" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <!-- Explaining text: muted, 12 px, wrapping. -->
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- A glyph of the icon font. -->
        <Style x:Key="Icon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Icons}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- A button that looks like the text it holds: for a heading that opens or folds what is under it. The keyboard
             reaches it (and shows where it is), and a screen reader names it. -->
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="2,1,6,1" />
            <Setter Property="Margin" Value="-2,-1,0,-1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Back" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{StaticResource RailSelected}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The rail's entries: one per page. Selected = lighter ground and full-strength text. -->
        <Style x:Key="RailItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Back" Background="Transparent" CornerRadius="6" Padding="9,7" SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{StaticResource RailHover}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsHeading}" Value="True">
                                <Setter TargetName="Back" Property="Padding" Value="9,12,9,1" />
                            </DataTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{StaticResource RailSelected}" />
                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- A group heading: not a page, so it cannot be chosen. -->
                <DataTrigger Binding="{Binding IsHeading}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                    <Setter Property="Focusable" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- A page shows its icon and its name, and a dot while it has something live to say; a group heading shows as
             small capitals (a thin line in the narrow rail). -->
        <DataTemplate x:Key="RailFull">
            <Grid>
                <DockPanel x:Name="Page">
                    <Ellipse DockPanel.Dock="Right" Width="7" Height="7" Fill="{Binding Dot}" VerticalAlignment="Center" Margin="6,1,0,0" />
                    <TextBlock Style="{StaticResource Icon}" Text="{Binding Icon}" FontSize="15" Width="25" FontWeight="Normal" />
                    <TextBlock Text="{Binding Title}" FontSize="13" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock x:Name="Heading" Text="{Binding Title}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Opacity="0.8" Visibility="Collapsed" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsHeading}" Value="True">
                    <Setter TargetName="Page" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Heading" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <!-- The narrow rail: the icon alone, and the page's name as its tooltip. -->
        <DataTemplate x:Key="RailShort">
            <Grid Background="Transparent" ToolTip="{Binding Title}">
                <Grid x:Name="Page">
                    <TextBlock Style="{StaticResource Icon}" Text="{Binding Icon}" FontSize="16" FontWeight="Normal" HorizontalAlignment="Center" />
                    <Ellipse Width="6" Height="6" Fill="{Binding Dot}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-4,0" />
                </Grid>
                <Border x:Name="Heading" Height="1" Background="{StaticResource Line}" Visibility="Collapsed" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsHeading}" Value="True">
                    <Setter TargetName="Page" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Heading" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <!-- The pages: only the selected one is shown; the rail on the left is the list of them. -->
        <ControlTemplate x:Key="PagesOnly" TargetType="TabControl">
            <ContentPresenter ContentSource="SelectedContent" />
        </ControlTemplate>
    </Application.Resources>
</Application>
