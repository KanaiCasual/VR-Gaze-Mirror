<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Windows Forms for the tray icon alone (WPF has none); its namespaces stay out of the implicit usings, which
         would otherwise clash with WPF's Application, MessageBox, Button and the rest. -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>GazeMirror</AssemblyName>
    <RootNamespace>GazeOverlay</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <Version>1.9.3</Version>
    <Product>VR Gaze Mirror</Product>
    <Description>Settings for quad views foveated rendering, the OBS mirror and its eye-gaze ring. Installing is done by the MSI, not by this app.</Description>

    <!-- Self-contained so no .NET install is needed, but as a plain folder of files that the MSI installs. Deliberately NOT
         a single-file/compressed exe and with nothing embedded: a self-extracting exe that carried the layer DLLs and
         installed them itself was quarantined by antivirus heuristics (2026-09-18). -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>embedded</DebugType>
    <!-- Application.ThemeMode (the built-in Fluent dark theme) is still flagged experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- The installer payload lives next to the project for the MSI build; it is not part of the app. -->
    <None Remove="Payload\**" />
    <Resource Include="Assets\icon.ico" />
    <!-- The changelog, shown on the About page. -->
    <EmbeddedResource Include="..\CHANGELOG.md" Link="CHANGELOG.md" LogicalName="CHANGELOG.md" />
    <!-- owner/name of the GitHub repository whose releases the app looks at. Empty = no update checks. Set by
         Build-Installer.ps1 -GitHubRepository owner/name. -->
    <AssemblyMetadata Include="GitHubRepository" Value="$(GitHubRepository)" />
  </ItemGroup>

</Project>
