<Window x:Class="GazeOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VR Gaze Mirror" Width="980" Height="680" MinWidth="460" MinHeight="360"
        WindowStartupLocation="CenterScreen" FontSize="13" UseLayoutRounding="True"
        Background="{StaticResource WindowBack}" Icon="Assets/icon.ico">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- The rail: the pages, and the version at the foot. It narrows to two letters a page in a small window. -->
        <Border x:Name="Rail" Background="{StaticResource Rail}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Padding="10,14,10,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,2,8,14">
                    <Ellipse Width="20" Height="20" Stroke="{StaticResource Accent}" StrokeThickness="2" />
                    <TextBlock x:Name="RailBrand" Text="Gaze Mirror" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>
                <TextBlock x:Name="RailVersion" DockPanel.Dock="Bottom" Style="{StaticResource Hint}" FontSize="11" Margin="10,6,0,0" />
                <ListBox x:Name="Nav" Background="Transparent" BorderThickness="0" Padding="0" ItemContainerStyle="{StaticResource RailItem}"
                         ItemTemplate="{StaticResource RailFull}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MinWidth="150" />
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Shown when a newer release exists. It only links to the release page; nothing is downloaded by the app. -->
            <Border x:Name="UpdateBanner" Visibility="Collapsed" Margin="18,14,18,0" Padding="14,10"
                    Background="#16283A" BorderBrush="#2F6FA8" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="UpdateTitle" FontWeight="SemiBold" />
                        <TextBlock x:Name="UpdateDetail" Style="{StaticResource Hint}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="UpdateInstallButton" Content="Download and install" FontWeight="SemiBold" Style="{DynamicResource AccentButtonStyle}" Margin="12,0,8,0" Click="OnInstallUpdate"
                                ToolTip="Saves the new installer into your Downloads folder, checks it against the SHA-256 the release publishes, and opens it with Windows Installer. This app closes for that; Windows asks for permission as for any installer." />
                        <Button x:Name="UpdateViewButton" Content="View release" Margin="0,0,8,0" Click="OnViewUpdate" />
                        <Button x:Name="UpdateSkipButton" Content="Skip this version" Margin="0,0,8,0" Click="OnSkipUpdate" />
                        <Button x:Name="UpdateLaterButton" Content="Later" Click="OnDismissUpdate" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- The pages and the ring preview share this inner grid, so nothing else can influence the preview column's width. -->
            <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="PreviewColumn" Width="Auto" />
            </Grid.ColumnDefinitions>
            <TabControl x:Name="Tabs" Grid.Column="0" Template="{StaticResource PagesOnly}" Background="Transparent" BorderThickness="0" Padding="0">

            <TabItem Header="Status">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18,14,18,12">
                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Content="Refresh" VerticalAlignment="Center" Click="OnRefresh" />
                            <TextBlock Style="{StaticResource PageTitle}" Text="Status" />
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="LiveDot" Width="8" Height="8" Margin="0,1,8,0" VerticalAlignment="Center" Fill="Gray" />
                                <TextBlock x:Name="LiveText" Style="{StaticResource Hint}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            </StackPanel>
                        </DockPanel>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="COMPONENTS" />
                                <StackPanel x:Name="StatusRows" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock x:Name="LayerHint" Style="{StaticResource CardTitle}" Text="OPENXR API LAYERS  -  THE TOP ONE LOADS CLOSEST TO THE GAME"
                                           ToolTip="In the order games load them. Tick boxes switch a layer on or off, the arrows reorder (Windows asks for permission)." />
                                <StackPanel x:Name="LayerRows" />
                                <TextBlock x:Name="LayerProblems" Foreground="Orange" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0" Visibility="Collapsed" />
                                <DockPanel Margin="0,6,0,0">
                                    <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                                        <Button x:Name="LayerFix" Content="Fix order" FontWeight="SemiBold" Margin="6,0,0,0" Visibility="Collapsed" Click="OnLayerFixOrder" />
                                        <Button x:Name="LayerApply" Content="Apply order" FontWeight="SemiBold" Margin="6,0,0,0" Visibility="Collapsed" Click="OnLayerApplyOrder" />
                                        <Button x:Name="LayerCancel" Content="Cancel" Margin="6,0,0,0" Visibility="Collapsed" Click="OnLayerCancelOrder" />
                                    </WrapPanel>
                                    <TextBlock x:Name="LayerNote" Style="{StaticResource Hint}" FontSize="12" VerticalAlignment="Center" />
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- The ring's own pages: cards of settings on the left, the preview on the right (see UpdatePanels). -->
            <TabItem x:Name="LookTab" Header="Ring">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18,14,18,12">
                        <TextBlock x:Name="LookTitle" Style="{StaticResource PageTitle}" Text="Ring" Margin="0,0,0,6" />
                        <WrapPanel x:Name="LookHeaderBar" Margin="0,0,0,6" />
                        <StackPanel x:Name="PanelLook" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="TailTab" Header="Tail">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18,14,18,12">
                        <TextBlock x:Name="TailTitle" Style="{StaticResource PageTitle}" Text="Tail" Margin="0,0,0,10" />
                        <StackPanel x:Name="PanelTail" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="MotionTab" Header="Motion">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18,14,18,12">
                        <TextBlock x:Name="MotionTitle" Style="{StaticResource PageTitle}" Text="Motion" Margin="0,0,0,10" />
                        <StackPanel x:Name="PanelMotion" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="PlacementTab" Header="Placement">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18,14,18,12">
                        <TextBlock x:Name="PlacementTitle" Style="{StaticResource PageTitle}" Text="Placement" Margin="0,0,0,10" />
                        <StackPanel x:Name="PanelPlacement" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="CropTab" Header="Mirror">
                <!-- The picture takes whatever height is left; in a small window it keeps a usable size and the page scrolls instead. -->
                <ScrollViewer x:Name="MirrorScroll" VerticalScrollBarVisibility="Auto">
                <DockPanel Margin="18,14,18,10" MinHeight="{Binding ViewportHeight, ElementName=MirrorScroll, Converter={StaticResource LessMargin}}">
                    <!-- Title, the profile, and the two things done to the picture: capture it, pause the mirror. -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                            <Button x:Name="CropCapture" Content="Capture from headset" FontWeight="SemiBold" Style="{DynamicResource AccentButtonStyle}" Margin="6,2,0,2" Click="OnCaptureArm"
                                    ToolTip="Take the picture from inside the headset instead of from the desk: arm this, put the headset on, sit the way you play, look straight ahead and press the key. It takes one picture of each eye and switches itself off again. The picture is kept until you press Refresh picture." />
                            <Button x:Name="CropCaptureKey" Content="Key: Pause" Margin="6,2,0,2" Click="OnCaptureKeyClick"
                                    ToolTip="The key that takes the picture while a capture is armed (it does nothing otherwise). Click, then press the key you want; Esc keeps the current one. The game sees the key too, so choose one that does no harm there (Pause only pauses most sims)." />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource PageTitle}" Text="Mirror" />
                    </DockPanel>
                    <!-- The profile: a saved framing, applied by itself when its game starts. -->
                    <WrapPanel DockPanel.Dock="Top" Margin="0,2,0,0">
                            <TextBlock Text="Profile" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,6,0"
                                       ToolTip="A saved framing (crop box, follow, steadying). One with a game name is applied by the mirror whenever that game starts." />
                            <ComboBox x:Name="CropProfile" MinWidth="200" Margin="0,2,6,2" VerticalAlignment="Center" DisplayMemberPath="Label" />
                            <Button x:Name="CropProfileSaveAs" Content="Save as..." ToolTip="Save the current framing as a profile" Margin="0,2,6,2" Click="OnProfileSaveAs" />
                            <StackPanel x:Name="CropProfileNamePanel" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,6,0">
                                <TextBox x:Name="CropProfileName" Width="140" MinWidth="0" Margin="0,2,4,2" VerticalAlignment="Center" ToolTip="Name of the profile. Enter saves, Esc cancels." />
                                <Button Content="OK" Margin="0,2,0,2" Click="OnProfileSaveConfirm" />
                            </StackPanel>
                            <Button x:Name="CropProfileDelete" Content="Delete" Margin="0,2,12,2" Click="OnProfileDelete" />
                            <TextBlock Text="For game" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ComboBox x:Name="CropProfileGame" IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True" MinWidth="170" MaxDropDownHeight="240"
                                      DisplayMemberPath="Label" TextSearch.TextPath="Exe" Margin="0,2,6,2" VerticalAlignment="Center"
                                      ToolTip="The game's program file, for example DCS.exe or VRChat.exe. Open the list to pick a running program, or type - the list narrows as you type. Enter applies. Empty = the profile is only applied when chosen here." />
                    </WrapPanel>
                    <TextBlock x:Name="CropProfileStatus" DockPanel.Dock="Top" Style="{StaticResource Hint}" FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap" />

                    <!-- Three cards: the picture every reader gets, the mirror window, the crop box. Side by side when there is room (set in code). -->
                    <UniformGrid x:Name="MirrorCards" DockPanel.Dock="Top" Columns="3" Margin="0,0,-10,0">
                        <Border Style="{StaticResource Card}" Margin="0,0,10,10">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="PICTURE" ToolTip="What OBS and the mirror window get." />
                                <UniformGrid x:Name="PanelOutput" Columns="1" />
                                <TextBlock x:Name="MirrorSource" Style="{StaticResource Hint}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                                <TextBlock x:Name="HelperStatus" Style="{StaticResource Hint}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"
                                           ToolTip="Games that use SteamVR directly (OpenVR) instead of OpenXR never load the mirror layer. A small helper program next to SteamVR mirrors them instead - same crop, same ring." />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,10,10">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="GAZE SOURCE"
                                           ToolTip="Where the ring gets the eyes from. The headset's own eye tracking is the main source and needs nothing. When the ring cannot get it, the avatar's eye values from VRChat stand in as a fallback - and that fallback is what the calibration below is for." />
                                <UniformGrid x:Name="PanelGaze" Columns="1" />
                                <TextBlock x:Name="ExternalGazeStatus" Style="{StaticResource Hint}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                                <TextBlock x:Name="RawGazeStatus" Style="{StaticResource Hint}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                                <DockPanel x:Name="VrchatCalibrationRow" Margin="0,6,0,0">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button x:Name="VrchatCalibrate" Content="Calibrate VRChat gaze" FontWeight="SemiBold" Margin="6,0,0,0" Click="OnVrchatCalibrate"
                                                ToolTip="Only for the VRChat fallback; the headset's own eye tracking needs no calibration. Put the headset on, have VRChat running, press this. A small ring-and-dot target appears in the headset at twenty places, about two seconds each: straight ahead, then out to 30 degrees to each side, 22 up and 30 down, then the four corners. Follow it with your eyes only, head still. About 45 seconds; the target then disappears and the ring lands where you look. Redo it after changing eye-tracking software or its own calibration." />
                                        <Button x:Name="VrchatCalibrationForget" Content="Forget" Margin="6,0,0,0" Click="OnVrchatCalibrationForget" ToolTip="Drop the calibration" />
                                    </StackPanel>
                                    <TextBlock x:Name="VrchatCalibrationStatus" Style="{StaticResource Hint}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </DockPanel>
                                <TextBlock x:Name="VrchatCalibrationHint" Style="{StaticResource Hint}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                                           Text="The calibration belongs to the fallback only: when the ring cannot get gaze from the headset and has to make do with the avatar's eye values from VRChat over OSC. Those values are not angles, so the helper measures once how they relate to where you look, with a target shown in the headset. As long as the headset's own eye tracking reaches the ring, none of this is used." />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,10,10">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="MIRROR WINDOW"
                                           ToolTip="A window that shows the mirror picture - cropped, with the ring - so that anything which can capture a window can use it: OBS Window Capture, Discord, ... No OBS plugin needed. It normally fills a monitor BEHIND your game and never comes to the front." />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="64" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Show on" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <ComboBox Grid.Row="0" Grid.Column="1" x:Name="MirrorPlacement" MinWidth="0" HorizontalAlignment="Stretch" Margin="0,2,0,2" VerticalAlignment="Center"
                                              ToolTip="Filling a monitor gives capture tools the full resolution of that monitor. The window stays behind every other window there." />
                                    <TextBlock Grid.Row="1" Text="Size" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <DockPanel Grid.Row="1" Grid.Column="1">
                                        <StackPanel x:Name="MirrorCustomSize" DockPanel.Dock="Right" Orientation="Horizontal" Visibility="Collapsed" Margin="6,0,0,0">
                                            <TextBox x:Name="MirrorCustomWidth" Width="56" MinWidth="0" Margin="0,2,4,2" VerticalAlignment="Center" ToolTip="Width in pixels (64 - 16384). Press Enter to apply." />
                                            <TextBlock Text="x" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                            <TextBox x:Name="MirrorCustomHeight" Width="56" MinWidth="0" Margin="0,2,0,2" VerticalAlignment="Center" ToolTip="Height in pixels (64 - 16384). Press Enter to apply." />
                                        </StackPanel>
                                        <ComboBox x:Name="MirrorSize" MinWidth="0" HorizontalAlignment="Stretch" Margin="0,2,0,2" VerticalAlignment="Center"
                                                  ToolTip="How many pixels the mirror window's picture has - that is what OBS or Discord get. Smaller costs less graphics card time. With a size chosen, the window sits in the monitor's top left corner (behind everything) instead of covering the monitor." />
                                    </DockPanel>
                                    <TextBlock Grid.Row="2" Text="Rate" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <ComboBox Grid.Row="2" Grid.Column="1" x:Name="MirrorRate" MinWidth="0" HorizontalAlignment="Stretch" Margin="0,2,0,2" VerticalAlignment="Center"
                                              ToolTip="The mirror window draws at most this many pictures a second, however fast the game runs. 30 halves its cost again - fine for Discord." />
                                </Grid>
                                <DockPanel Margin="0,6,0,0">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button x:Name="MirrorOpen" Content="Open" FontWeight="SemiBold" Margin="6,0,0,0" Click="OnMirrorOpen" />
                                        <Button x:Name="MirrorClose" Content="Close" Margin="6,0,0,0" Click="OnMirrorClose" />
                                    </StackPanel>
                                    <CheckBox x:Name="MirrorTitled" Content="Title bar" MinWidth="0" VerticalAlignment="Center"
                                              ToolTip="Only when filling a monitor: keep a title bar (pushed off the top of the monitor). Try it if a capture tool does not list the window." />
                                </DockPanel>
                                <TextBlock x:Name="MirrorStatus" Style="{StaticResource Hint}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,10,10">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="CROP BOX"
                                           ToolTip="Drag inside the box to move it; drag a corner or use the mouse wheel over it to resize. The ring and the calibration are drawn on the whole image first, so the crop never affects them." />
                                <DockPanel>
                                    <ComboBox x:Name="CropAspect" DockPanel.Dock="Right" MinWidth="110" Margin="6,2,0,2" VerticalAlignment="Center" />
                                    <CheckBox x:Name="CropEnabled" Content="Crop the picture" MinWidth="0" VerticalAlignment="Center"
                                              ToolTip="Hand OBS only the box instead of the whole eye image" />
                                </DockPanel>
                                <WrapPanel Margin="0,4,0,0">
                                    <Button x:Name="CropCentreButton" Content="Centre" ToolTip="Put the box in the middle of the image" Margin="0,2,6,2" Click="OnCropCentre" />
                                    <Button x:Name="CropLargestButton" Content="Largest" ToolTip="Make the box as large as the image allows" Margin="0,2,6,2" Click="OnCropFill" />
                                    <CheckBox x:Name="CropLocked" Content="Lock" MinWidth="0" Margin="2,0,8,0" VerticalAlignment="Center"
                                              ToolTip="Locked: the box cannot be moved or resized with the mouse, so a stray click or scroll changes nothing" />
                                </WrapPanel>
                                <WrapPanel Margin="0,2,0,0">
                                    <Button x:Name="CropRefresh" Content="Refresh picture" ToolTip="Ask the running game for a new picture of the mirror image, right now" Margin="0,2,6,2" Click="OnCropRefresh" />
                                    <ComboBox x:Name="CropPictureEye" MinWidth="120" Margin="0,2,0,2" VerticalAlignment="Center" Visibility="Collapsed"
                                              ToolTip="Which eye's picture is shown behind the box. The box itself is the same for both eyes." />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Capture from the headset, armed: impossible to miss, and says what to do. -->
                    <Border x:Name="CaptureBanner" DockPanel.Dock="Top" Margin="0,0,0,8" Padding="14,10" Visibility="Collapsed"
                            Background="#3A2A0C" BorderBrush="#E09A2B" BorderThickness="2" CornerRadius="8">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Cancel" Margin="12,0,0,0" VerticalAlignment="Center" Click="OnCaptureCancel" />
                            <StackPanel>
                                <TextBlock FontSize="16" FontWeight="Bold" Foreground="#FFC35A" Text="CAPTURE ARMED - waiting for the key" />
                                <TextBlock TextWrapping="Wrap" Margin="0,3,0,0">
                                    <Run Text="1. Put the headset on.  2. Sit the way you play and look straight ahead.  3. Press" />
                                    <Run x:Name="CaptureBannerKey" FontWeight="Bold" Foreground="#FFC35A" Text="Pause" /><Run Text=".  A sound tells you the picture was taken; this then switches itself off." />
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <!-- The two fold-away sections sit side by side when there is room (set in code). -->
                    <UniformGrid x:Name="MirrorSections" DockPanel.Dock="Top" Columns="1">
                    <Expander x:Name="CropFollowExpander" Header="Follow my gaze (up / down)" Margin="0,0,0,6" VerticalAlignment="Top">
                        <!-- Two columns when there is room (set in code), so the settings take little height from the picture. -->
                        <UniformGrid x:Name="PanelCropFollow" Columns="1" Margin="0,4,0,0" />
                    </Expander>
                    <Expander x:Name="StabilizeExpander" Header="Steady the picture (head movement)" Margin="0,0,0,6" VerticalAlignment="Top">
                        <UniformGrid x:Name="PanelStabilize" Columns="1" Margin="0,4,0,0" />
                    </Expander>
                    </UniformGrid>
                    <WrapPanel DockPanel.Dock="Top" Margin="0,2,0,6">
                        <TextBlock x:Name="CropReadout" FontWeight="SemiBold" Margin="0,0,12,0" />
                        <TextBlock x:Name="CropStatus" Style="{StaticResource Hint}" FontSize="12" VerticalAlignment="Center" />
                    </WrapPanel>
                    <Border x:Name="CropFrameBorder" Background="{StaticResource Picture}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" ClipToBounds="True" MinHeight="240"
                            ToolTip="Drag inside the box to move it; drag a corner or use the mouse wheel over it to resize. In OBS: set the crop values in the source's Properties to 0, then select the source and press Ctrl+F (Transform > Fit to screen) once - after that it keeps fitting when the box changes size.">
                        <Canvas x:Name="CropCanvas" Background="Transparent" ClipToBounds="True" />
                    </Border>
                </DockPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="QuadViewsTab" Header="Quad Views">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="18,14,18,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="File" ToolTip="Open Quad-Views-Foveated's settings file" Margin="6,0,0,0" Click="OnQuadViewsOpenFile" />
                            <Button Content="Log" ToolTip="Open Quad-Views-Foveated's log" Margin="6,0,0,0" Click="OnQuadViewsOpenLog" />
                        </StackPanel>
                        <TextBlock x:Name="QuadViewsTitle" Style="{StaticResource PageTitle}" Text="Quad Views"
                                   ToolTip="Quad-Views-Foveated's own settings. They are read when a game starts: Apply, then restart the game. The sliders work like TallyMouse's QuadViews Companion and edit the same file, with one difference: values are also written where every OpenXR runtime reads them, not only under a list of known headsets." />
                    </DockPanel>
                    <!-- Stays in view while the sliders scroll: what the settings cost, Apply, and the presets. -->
                    <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="18,0,18,0">
                        <StackPanel>
                            <TextBlock x:Name="QuadViewsLoadLast" Foreground="Orange" TextWrapping="Wrap" FontSize="12" />
                            <TextBlock x:Name="QuadViewsLoadSaved" TextWrapping="Wrap" Margin="0,1,0,0" />
                            <TextBlock x:Name="QuadViewsLoadNext" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,1,0,0" />
                            <WrapPanel Margin="0,6,0,0">
                                <Button x:Name="QuadViewsApply" Content="Apply" FontWeight="SemiBold" Style="{DynamicResource AccentButtonStyle}" MinWidth="76" Margin="0,2,6,2" Click="OnQuadViewsApply" />
                                <Button x:Name="QuadViewsRevert" Content="Revert" Margin="0,2,14,2" Click="OnQuadViewsRevert" />
                                <TextBlock Text="Presets" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <WrapPanel x:Name="QuadViewsPresets" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <WrapPanel x:Name="QuadViewsSlots" VerticalAlignment="Center" />
                            </WrapPanel>
                            <TextBlock x:Name="QuadViewsStatus" Style="{StaticResource Hint}" FontSize="12" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="QuadViewsNotice" DockPanel.Dock="Top" Margin="18,8,18,0" Padding="12,6"
                            Background="#2A2112" BorderBrush="#6B4F14" BorderThickness="1" CornerRadius="8">
                        <TextBlock x:Name="QuadViewsNoticeText" TextWrapping="Wrap" FontSize="12" Foreground="#E8D4A8" />
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="PanelQuadViews" Margin="18,10,18,12" />
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <TabItem Header="About">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18,14,18,12">
                        <TextBlock Style="{StaticResource PageTitle}" Text="About" Margin="0,0,0,10" />
                        <UniformGrid x:Name="AboutCards" Columns="2" Margin="0,0,-10,0">
                            <Border Style="{StaticResource Card}" Margin="0,0,10,10">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardTitle}" Text="QUADVIEWS GAZE MIRROR" />
                                    <TextBlock x:Name="VersionText" FontSize="22" FontWeight="SemiBold" />
                                    <WrapPanel Margin="0,8,0,0">
                                        <Button x:Name="RepoButton" Content="GitHub" Margin="0,2,6,2" Click="OnOpenRepo" />
                                        <Button x:Name="ReleasesButton" Content="Releases" Margin="0,2,6,2" Click="OnOpenReleases" />
                                        <Button Content="Licences" ToolTip="Open the folder with the licence texts" Margin="0,2,6,2" Click="OnOpenLicences" />
                                        <Button Content="Logs" ToolTip="Open the folder with this app's, the layer's and the helper's logs" Margin="0,2,0,2" Click="OnOpenLogs" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,10,10">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardTitle}" Text="UPDATES"
                                               ToolTip="The app can look at the project's GitHub releases when it opens and tell you when a newer version exists. It only reads that public list - it never downloads or installs anything. You get a link to the release page and install the new .msi yourself." />
                                    <CheckBox x:Name="CheckUpdatesBox" Content="Check for updates when the app opens" MinWidth="0" Checked="OnUpdatePreferenceChanged" Unchecked="OnUpdatePreferenceChanged" />
                                    <CheckBox x:Name="IncludeBetasBox" Content="Also tell me about beta versions" MinWidth="0" Margin="0,4,0,0" Checked="OnUpdatePreferenceChanged" Unchecked="OnUpdatePreferenceChanged" />
                                    <DockPanel Margin="0,8,0,0">
                                        <Button x:Name="CheckNowButton" DockPanel.Dock="Left" Content="Check now" Margin="0,0,10,0" VerticalAlignment="Center" Click="OnCheckNow" />
                                        <TextBlock x:Name="UpdateStatus" Style="{StaticResource Hint}" FontSize="12" VerticalAlignment="Center" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="WHAT RUNS WHERE" />
                                <StackPanel x:Name="AboutRows" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="WHAT CHANGED" />
                                <StackPanel x:Name="ChangelogRows" />
                            </StackPanel>
                        </Border>
                        <Expander Header="Licences and credits" Margin="0,10,0,0">
                            <TextBlock x:Name="AboutText" TextWrapping="Wrap" Style="{StaticResource Hint}" Margin="0,6,0,0" />
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            </TabControl>

            <!-- The ring preview. Hidden on narrow windows and with the Preview switch below, so the app can sit beside a game. -->
            <Border x:Name="RingPanel" Grid.Column="1" Style="{StaticResource Card}" Margin="0,14,18,0" VerticalAlignment="Top">
                <StackPanel Width="260">
                    <TextBlock Style="{StaticResource CardTitle}" Text="PREVIEW" />
                    <Border Background="Black" Width="260" Height="260" CornerRadius="6" ClipToBounds="True">
                        <Image x:Name="PreviewImage" Width="260" Height="260" Stretch="None"
                               ToolTip="Approximate: about what a cropped 1080p stream shows. The real ring scales with your OBS source's size and crop." />
                    </Border>
                    <UniformGrid Columns="2" Margin="0,6,0,0">
                        <RadioButton x:Name="BgCockpit" Content="Cockpit" IsChecked="True" MinWidth="0" Checked="OnPreviewOptionChanged" />
                        <RadioButton x:Name="BgTerrain" Content="Terrain" MinWidth="0" Checked="OnPreviewOptionChanged" />
                        <RadioButton x:Name="BgSky" Content="Sky" MinWidth="0" Checked="OnPreviewOptionChanged" />
                        <RadioButton x:Name="BgBlack" Content="Black" MinWidth="0" Checked="OnPreviewOptionChanged" />
                    </UniformGrid>
                    <CheckBox x:Name="PreviewMoving" Content="Eyes moving (tail)" MinWidth="0" Checked="OnPreviewOptionChanged" Unchecked="OnPreviewOptionChanged" />
                </StackPanel>
            </Border>
            </Grid>

            <!-- Ring settings save by themselves; this says when, and whether a running game took them. -->
            <Grid x:Name="BottomBar" Grid.Row="2" Margin="18,4,18,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SaveStatus" Style="{StaticResource Hint}" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <CheckBox x:Name="PreviewToggle" Content="Preview" IsChecked="True" MinWidth="0" Margin="8,0,8,0" Checked="OnLayoutOptionChanged" Unchecked="OnLayoutOptionChanged" />
                    <Button Content="File" ToolTip="Open the ring's settings file" Margin="0,0,6,0" Click="OnOpenConfig" />
                    <Button Content="Reload" ToolTip="Read the ring's settings file again" Click="OnReloadConfig" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
