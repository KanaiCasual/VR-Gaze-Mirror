<Project Sdk="WixToolset.Sdk/5.0.2">

  <PropertyGroup>
    <OutputName>VR-Gaze-Mirror</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <!-- Set by Build-Installer.ps1; the defaults let the project build on its own too. -->
    <ProductVersion Condition="'$(ProductVersion)' == ''">1.9.3</ProductVersion>
    <PayloadDir Condition="'$(PayloadDir)' == ''">$(MSBuildProjectDirectory)\..\GazeOverlayApp\Payload</PayloadDir>
    <AppDir Condition="'$(AppDir)' == ''">$(MSBuildProjectDirectory)\..\dist\app</AppDir>
    <!-- ICE61 objects to AllowSameVersionUpgrades and ICE40 to REINSTALLMODE in the Property table: both deliberate (see Package.wxs). -->
    <SuppressIces>ICE61;ICE40</SuppressIces>
    <DefineConstants>ProductVersion=$(ProductVersion);PayloadDir=$(PayloadDir);AppDir=$(AppDir)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
  </ItemGroup>

</Project>
